<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="market.fx.screens.MainController">

    <top>
        <VBox spacing="6.0" styleClass="top-bar">
            <padding>
                <Insets top="10.0" right="12.0" bottom="8.0" left="12.0"/>
            </padding>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button fx:id="loadFileButton" text="Load file..." onAction="#onLoadFile"/>
                <Label text="Current file:"/>
                <Label fx:id="loadedFileLabel" text="none loaded yet" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <ProgressBar fx:id="loadProgress" progress="0.0" prefWidth="220.0" visible="false"/>
                <Label fx:id="statusLabel" text="" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="eventsTab" text="Events">
                    <content>
                        <fx:include fx:id="eventsView" source="events-view.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="usersTab" text="Users">
                    <content>
                        <Label fx:id="usersPlaceholder" text="Load a file to see the users."/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
