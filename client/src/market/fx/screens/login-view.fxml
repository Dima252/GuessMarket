<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The first thing a user sees: a name, and nothing else. It sits in a
     ScrollPane like every other screen, so that it survives a small window. -->
<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="market.fx.screens.LoginController"
            fitToWidth="true" fitToHeight="true">
    <content>
        <StackPane>
            <VBox spacing="12.0" maxWidth="420.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>
                <Label fx:id="title" text="Guess Market"/>
                <Label text="Log in with a name of your own. There is no password: a new name opens a new account."
                       wrapText="true"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <TextField fx:id="nameField" promptText="your name" HBox.hgrow="ALWAYS"
                               onAction="#onLogin"/>
                    <Button fx:id="loginButton" text="Log in" defaultButton="true" onAction="#onLogin"/>
                </HBox>
                <Label fx:id="messageLabel" text="" wrapText="true"/>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
