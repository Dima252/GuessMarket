<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- Bonus: a chat that every logged in user shares, through the server only. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="market.fx.screens.ChatController" spacing="8.0">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>
    <Label text="Everybody logged in sees what is written here."/>
    <ListView fx:id="linesList" VBox.vgrow="ALWAYS" minHeight="80.0"/>
    <HBox spacing="8.0">
        <TextField fx:id="messageField" promptText="write a message" HBox.hgrow="ALWAYS" onAction="#onSend"/>
        <Button fx:id="sendButton" text="Send" onAction="#onSend"/>
    </HBox>
    <Label fx:id="statusLabel" text="" wrapText="true"/>
</VBox>
