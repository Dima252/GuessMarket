<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market>
    <GM-events>
        <GM-event name="Rain in July">
            <id>1</id>
            <description>Will it rain anywhere in the country during July?</description>
            <comision type="on-purchase">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>100</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event name="Summit Between the Leaders">
            <id>2</id>
            <description>Will a summit take place before the end of the season?</description>
            <comision type="on-close">20</comision>
            <GM-options>
                <GM-option>It will happen</GM-option>
                <GM-option>It will not happen</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>50</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event name="A Very Nervous Market">
            <id>7</id>
            <description>A small liquidity value makes every purchase move the price sharply.</description>
            <comision type="on-close">0</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>1</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
